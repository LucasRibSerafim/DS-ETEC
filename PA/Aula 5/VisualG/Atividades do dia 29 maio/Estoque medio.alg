algoritmo "Calcular estoque médio"

var
   estqMed, QtdMin, QtdMax : real
inicio
      Escreva("Qual a quantidade miníma? ")
      Leia(QtdMin)
      Escreva("Qual a quantidade maxíma? ")
      Leia(QtdMax)
      estqMed <- (QtdMin + QtdMax) /2
      Escreva("O estoque médio é ", estqMed)
      

fimalgoritmo
