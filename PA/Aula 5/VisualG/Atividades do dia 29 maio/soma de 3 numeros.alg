algoritmo "Soma de 3 numeros"

var
   n1, n2, n3, soma:inteiro
inicio
      Escreva("Digíte o primeiro número: ")
      Leia(n1)
      Escreva("Digíte o segundo número: ")
      Leia(n2)
      Escreva("Digíte o terceiro número: ")
      Leia(n3)
      soma <- n1 + n2 + n3
      Escreva("O valor da soma é", soma)
Fimalgoritmo
